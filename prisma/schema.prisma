generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")        // 1er choix (priorité)
}

// ─────────────────────────────────────────
// UTILISATEURS & FAMILLES
// ─────────────────────────────────────────


model User {
  id               String   @id @default(uuid())
  email            String?  @unique
  telephone        String?  @unique
  username         String?  @unique
  passwordHash     String   @map("password_hash")
  nom              String
  prenom           String
  questionSecrete  String?  @map("question_secrete")
  reponseHash      String?  @map("reponse_hash")
  emailVerified    Boolean  @default(false) @map("email_verified")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  familleMembres   FamilleMembre[]
  syncLogs         SyncLog[]
  stories          Story[]
  storyReactions   StoryReaction[]
  storyComments    StoryComment[]
  storyViews       StoryView[]
  notifications    Notification[]
  passwordResets   PasswordReset[]
  emailVerifications EmailVerification[]

  @@map("users")
}

model Famille {
  id                    String   @id @default(uuid())
  nom                   String
  codeUnique            String?  @unique @map("code_unique")
  lieu                  String?
  description           String?
  viewonlyUsername      String?  @unique @map("viewonly_username")
  viewonlyPassword      String?  @map("viewonly_password")
  viewonlyPasswordHash  String?  @map("viewonly_password_hash")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  membres       FamilleMembre[]
  personnes     Personne[]
  unions        Union[]
  stories       Story[]
  photos        Photo[]
  notifications Notification[]
  subscription  Subscription?

  @@map("familles")
}

model FamilleMembre {
  id         String   @id @default(uuid())
  familleId  String   @map("famille_id")
  userId     String   @map("user_id")
  role       String   @default("membre") // admin, gestionnaire, membre
  joinedAt   DateTime @default(now()) @map("joined_at")
  personneId String?  @unique @map("personne_id") // lien optionnel vers l'arbre généalogique (1 compte max par personne)

  famille    Famille   @relation(fields: [familleId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  personne   Personne? @relation(fields: [personneId], references: [id], onDelete: SetNull)

  @@unique([familleId, userId])
  @@map("famille_membres")
}

// ─────────────────────────────────────────
// PERSONNES
// ─────────────────────────────────────────

model Personne {
  id            String    @id @default(uuid())
  familleId     String    @map("famille_id")
  nomNaissance  String?   @map("nom_naissance")
  nomUsage      String?   @map("nom_usage")
  prenoms       String?
  sexe          String?   // M, F, autre
  dateNaissance String?   @map("date_naissance") // format: YYYY, YYYY-MM, YYYY-MM-DD
  lieuNaissance String?   @map("lieu_naissance")
  dateDeces     String?   @map("date_deces")
  lieuDeces     String?   @map("lieu_deces")
  biographie    String?
  notes         String?
  photoUrl      String?   @map("photo_url")   // URL distante (upload)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  famille           Famille            @relation(fields: [familleId], references: [id], onDelete: Cascade)
  unionParticipants UnionParticipant[]
  filiations        Filiation[]
  familleMembre     FamilleMembre?
  photos            Photo[]

  @@map("personnes")
}

// ─────────────────────────────────────────
// UNIONS & FILIATIONS
// ─────────────────────────────────────────

model Union {
  id         String    @id @default(uuid())
  familleId  String    @map("famille_id")
  type       String?   // mariage, union_libre, fiancailles, etc.
  dateDebut  String?   @map("date_debut")
  lieuDebut  String?   @map("lieu_debut")
  dateFin    String?   @map("date_fin")
  lieuFin    String?   @map("lieu_fin")
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  famille      Famille           @relation(fields: [familleId], references: [id], onDelete: Cascade)
  participants UnionParticipant[]
  filiations   Filiation[]

  @@map("unions")
}

// Lien union ↔ parents (les deux conjoints)
model UnionParticipant {
  id         String   @id @default(uuid())
  unionId    String   @map("union_id")
  personneId String   @map("personne_id")
  role       String   @default("conjoint")
  ordre      Int      @default(0)

  union      Union    @relation(fields: [unionId], references: [id], onDelete: Cascade)
  personne   Personne @relation(fields: [personneId], references: [id], onDelete: Cascade)

  @@unique([unionId, personneId])
  @@map("union_participants")
}

// Lien union ↔ enfants
model Filiation {
  id               String   @id @default(uuid())
  unionId          String   @map("union_id")
  enfantId         String   @map("enfant_id")
  ordreNaissance   Int      @default(0) @map("ordre_naissance")

  union            Union    @relation(fields: [unionId], references: [id], onDelete: Cascade)
  enfant           Personne @relation(fields: [enfantId], references: [id], onDelete: Cascade)

  @@unique([unionId, enfantId])
  @@map("filiations")
}

// ─────────────────────────────────────────
// STORIES
// ─────────────────────────────────────────

model Story {
  id          String    @id @default(uuid())
  familleId   String    @map("famille_id")
  creatorId   String    @map("creator_id")

  // Contenu
  titre       String?
  caption     String                          // texte principal
  tag         String?                         // Souvenir, Événement, Culture…
  mediaUrl    String?   @map("media_url")     // URL Cloudinary
  mediaType   String?   @map("media_type")    // photo | video | text

  // Expiration (null = permanent pour le web, 24h pour le mobile)
  expiresAt   DateTime? @map("expires_at")

  // Visibilité
  privacy     String    @default("family")    // family | custom | private

  // Stats
  viewCount   Int       @default(0) @map("view_count")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  famille     Famille        @relation(fields: [familleId], references: [id], onDelete: Cascade)
  creator     User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  reactions   StoryReaction[]
  comments    StoryComment[]
  views       StoryView[]

  @@index([familleId, createdAt])
  @@map("stories")
}

model StoryReaction {
  id        String   @id @default(uuid())
  storyId   String   @map("story_id")
  userId    String   @map("user_id")
  emoji     String   @default("❤️")
  createdAt DateTime @default(now()) @map("created_at")

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@map("story_reactions")
}

model StoryComment {
  id        String         @id @default(uuid())
  storyId   String         @map("story_id")
  userId    String         @map("user_id")
  parentId  String?        @map("parent_id")
  content   String
  createdAt DateTime       @default(now()) @map("created_at")

  story     Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    StoryComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   StoryComment[] @relation("CommentReplies")

  @@map("story_comments")
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String   @map("story_id")
  userId   String   @map("user_id")
  viewedAt DateTime @default(now()) @map("viewed_at")

  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@map("story_views")
}

// ─────────────────────────────────────────
// ALBUMS PHOTOS
// ─────────────────────────────────────────

model Photo {
  id        String   @id @default(uuid())
  personneId String  @map("personne_id")
  familleId  String  @map("famille_id")
  url        String
  caption    String?
  datePrise  String? @map("date_prise")   // YYYY, YYYY-MM ou YYYY-MM-DD
  lieuPrise  String? @map("lieu_prise")
  createdAt  DateTime @default(now()) @map("created_at")

  personne   Personne @relation(fields: [personneId], references: [id], onDelete: Cascade)
  famille    Famille  @relation(fields: [familleId], references: [id], onDelete: Cascade)

  @@index([personneId])
  @@map("photos")
}

// ─────────────────────────────────────────
// FREEMIUM — PLANS & ABONNEMENTS
// ─────────────────────────────────────────

model Plan {
  id           String  @id               // 'plan_gratuit' | 'plan_premium' | 'plan_famille_plus'
  nom          String                    // slug
  label        String                    // label affiché
  prix         Int                       // FCFA/mois (0 = gratuit)
  maxPersonnes Int?                      // null = illimité
  features     Json                      // string[]

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id         String    @id @default(uuid())
  familleId  String    @unique @map("famille_id")
  planId     String    @map("plan_id")
  statut     String    @default("actif")  // actif | expire | annule
  dateDebut  DateTime  @map("date_debut")
  dateFin    DateTime? @map("date_fin")   // null = gratuit/permanent
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  famille    Famille    @relation(fields: [familleId], references: [id], onDelete: Cascade)
  plan       Plan       @relation(fields: [planId], references: [id])
  paiements  Paiement[]

  @@map("subscriptions")
}

model Paiement {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  transactionId  String   @unique @map("transaction_id")
  montant        Int
  statut         String   @default("pending")  // pending | success | failed
  provider       String   @default("cinetpay")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("paiements")
}

// ─────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────

model Notification {
  id          String   @id @default(uuid())
  familleId   String   @map("famille_id")
  userId      String   @map("user_id")
  type        String   // 'anniversaire' | 'bienvenue'
  titre       String
  message     String
  lue         Boolean  @default(false)
  data        Json?    // { personneId, nom, age, photoUrl }
  createdAt   DateTime @default(now()) @map("created_at")

  famille     Famille  @relation(fields: [familleId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lue])
  @@index([familleId])
  @@map("notifications")
}

// ─────────────────────────────────────────
// AUTH TOKENS
// ─────────────────────────────────────────

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_resets")
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verifications")
}

// ─────────────────────────────────────────
// SYNC OFFLINE
// ─────────────────────────────────────────

model SyncLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  familleId    String   @map("famille_id")
  entityType   String   @map("entity_type")   // personne, union, filiation
  entityId     String   @map("entity_id")
  operation    String                          // create, update, delete
  payload      Json?                           // données complètes
  syncedAt     DateTime @default(now()) @map("synced_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familleId, syncedAt])
  @@map("sync_logs")
}
